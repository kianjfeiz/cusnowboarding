# Copy to .env.local and fill in. `npm run db:up` starts the local database.
#
# DATABASE_URL points at PgBouncer (6432), matching production where the app
# talks to Neon's pooler. DIRECT_DATABASE_URL bypasses it for migrations.
DATABASE_URL="postgresql://cusnow:cusnow_local_dev@localhost:6432/cusnow"
DIRECT_DATABASE_URL="postgresql://cusnow:cusnow_local_dev@localhost:55432/cusnow"

NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Generate with: openssl rand -base64 32
MEMBER_JWT_SECRET=""
VERIFY_PEPPER=""
AUTH_SECRET=""
CRON_SECRET=""

# Google OAuth. Used by BOTH the board and members - one sign-in resolves both,
# because a board member is also someone who goes on trips. Members cannot sign
# in at all until these exist.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""


# Cloudflare R2 for trip photos. Without these the galleries degrade to a
# "photos are not configured" notice rather than breaking.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# Where members are sent to pay. The club bills through CU's Fusion club-sports
# portal, which has no API - this is a link only, and payments are reconciled by
# hand. A trip can override it with its own payment_url.
NEXT_PUBLIC_PAYMENT_URL="https://club.fusionfamily.com/@/cusportclubs"

# Phase 3 - transactional email
RESEND_API_KEY=""
EMAIL_FROM="CU Snowboarding <noreply@example.com>"

# Read-only demo access. Set this and the login page grows a password box that
# lets someone without a CU Google account browse the member site: no claim
# cookie, no board portal, no member row. Leave it unset and the provider is
# never registered at all. Minimum 12 characters.
DEMO_PASSWORD=""

# Phase 7 - rate limiting
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
